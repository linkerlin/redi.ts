{
  "name": "redi.ts",
  "version": "2.4.0",
  "description": "TypeScript 1:1 port of Redisson — wire-compatible with Java Redisson (JsonJacksonCodec), redi.py and redi.go",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linkerlin/redi.ts.git"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "README_EN.md", "COMPATIBILITY.md", "CHANGELOG.md", "AGENTS.md"],
  "scripts": {
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "pack-smoke": "node scripts/pack-smoke.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["redis", "redisson", "distributed", "lock", "map", "queue", "topic", "rate-limiter", "bloom-filter"],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ioredis-mock": "^8.13.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
